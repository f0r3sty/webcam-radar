{
  "name": "webcam-radar",
  "version": "1.0.0",
  "description": "全球摄像头 - 实时轮播世界各地的公开直播摄像头",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac"
  },
  "author": "liguanghui",
  "license": "MIT",
  "build": {
    "appId": "com.liguanghui.webcamradar",
    "productName": "全球摄像头",
    "files": [
      "main.js",
      "preload.js",
      "catalog.json",
      "renderer/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "webcam-radar-setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "webcam-radar-${version}-portable.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  }
}
